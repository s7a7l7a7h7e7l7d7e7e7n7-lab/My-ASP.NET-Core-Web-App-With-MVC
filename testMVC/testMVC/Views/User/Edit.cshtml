@model testMVC.Models.User

@{
    ViewData["Title"] = "الديوان الملكي | تعديل بيانات العضو";
}

<!-- استيراد خطوط ملكية عالمية (Amiri & Cinzel & Cairo) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cairo:wght@400;500;600;700;800;900&family=Cinzel:wght@600;700;800;900&display=swap" rel="stylesheet">

<div class="royal-page-wrapper" id="royalPageWrapper" dir="rtl">
    
    <!-- خلفيات الإضاءة المحيطة المربوطة بلون صندوق الإعدادات -->
    <div class="royal-light-sphere sphere-1"></div>
    <div class="royal-light-sphere sphere-2"></div>

    <div class="container py-5 position-relative">
        
        <!-- زر الرجوع السريع للسجل الملكي -->
        <div class="mb-4">
            <a asp-controller="User" asp-action="Index" class="btn-royal-back">
                <span class="back-arrow">→</span>
                <span>العودة إلى سجل الأعضاء الملكي</span>
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                
                <!-- البطاقة الملكية الفاخرة للنموذج -->
                <div class="imperial-card rounded-5 overflow-hidden position-relative shadow-2xl">
                    
                    <!-- زخارف الزوايا الملكية الرفيعة -->
                    <div class="gold-corner-filigree top-right-corner"></div>
                    <div class="gold-corner-filigree top-left-corner"></div>

                    <!-- الترويسة العلوية للبطاقة -->
                    <div class="card-imperial-header text-center p-4 p-md-5 pb-3">
                        <div class="avatar-monogram-wrapper position-relative d-inline-block mb-3">
                            <div class="monogram-outer-ring">
                                <div class="monogram-inner-core">
                                    @(string.IsNullOrEmpty(Model?.userName) ? "U" : Model.userName.Substring(0, 1).ToUpper())
                                </div>
                            </div>
                            <div class="monogram-crown-pendant">
                                <svg class="royal-svg-mini" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                </svg>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                            <span class="royal-status-crest">تعديل بيانات العضو</span>
                            <span class="royal-seal-id">#@(Model?.Id.ToString("D3"))</span>
                        </div>
                        <h2 class="royal-form-title mb-1">تحديث السجل الملكي</h2>
                        <p class="royal-form-subtitle mb-0">قم بتعديل البيانات المطلوبة ثم اعتمد التغييرات في المنظومة</p>
                    </div>

                    <div class="px-4 px-md-5">
                        <hr class="royal-divider my-2" />
                    </div>

                    <!-- نموذج الإدخال والتعديل -->
                    <div class="card-imperial-body p-4 p-md-5 pt-3">
                        <form asp-controller="User" asp-action="Edit" method="post">
                            <div asp-validation-summary="ModelOnly" class="royal-validation-summary mb-3 p-3 rounded-3 small"></div>

                            <!-- معرف العضو المخفي -->
                            <input type="hidden" asp-for="Id" />

                            <!-- حقل اسم المستخدم -->
                            <div class="mb-4">
                                <label asp-for="userName" class="royal-input-label mb-2">
                                    <svg class="label-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    <span>اسم العضو النخبوي (User Name)</span>
                                </label>
                                <div class="royal-field-wrapper">
                                    <input asp-for="userName" class="royal-form-control" placeholder="أدخل اسم العضو" />
                                </div>
                                <span asp-validation-for="userName" class="royal-field-error"></span>
                            </div>

                            <!-- حقل البريد الإلكتروني -->
                            <div class="mb-4">
                                <label asp-for="Email" class="royal-input-label mb-2">
                                    <svg class="label-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                    <span>البريد الإلكتروني المعتمد (Email Address)</span>
                                </label>
                                <div class="royal-field-wrapper">
                                    <input asp-for="Email" type="email" class="royal-form-control" placeholder="name@domain.com" dir="ltr" />
                                </div>
                                <span asp-validation-for="Email" class="royal-field-error"></span>
                            </div>

                            <!-- حقل كلمة المرور -->
                            <div class="mb-4">
                                <label asp-for="Password" class="royal-input-label mb-2">
                                    <svg class="label-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                    <span>كلمة المرور الجديدة (PassWord)</span>
                                </label>
                                <div class="royal-field-wrapper">
                                    <input asp-for="Password" class="royal-form-control" placeholder="اتركه فارغاً إذا لم ترغب بالتغيير" />
                                </div>
                                <span asp-validation-for="Password" class="royal-field-error"></span>
                            </div>

                            <!-- أزرار الإجراءات -->
                            <div class="d-flex flex-column flex-sm-row gap-3 pt-2">
                                <button type="submit" class="btn btn-imperial-action flex-fill py-3">
                                    <svg class="btn-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                        <polyline points="7 3 7 8 15 8"></polyline>
                                    </svg>
                                    <span>حفظ التعديلات الملكية</span>
                                </button>
                                <a asp-controller="User" asp-action="Index" class="btn btn-imperial-outline flex-fill py-3 text-center">
                                    <span>إلغاء الأمر</span>
                                </a>
                            </div>

                        </form>
                    </div>

                </div>

            </div>
        </div>

    </div>
</div>

<!-- ================= التنسيقات الملكية الديناميكية المربوطة بـ --main--color ================= -->
<style>
    :root {
        --main--color: #084641;
    }

    .royal-page-wrapper {
        font-family: 'Cairo', 'Segoe UI', Tahoma, sans-serif;
        --theme-color: var(--main--color, #084641);

        background: radial-gradient(circle at 50% 6%, color-mix(in srgb, var(--theme-color) 12%, #0A0D14) 0%, #06080B 75%);
        color: #FAF8F2;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        margin-top: -20px;
        padding-top: 25px;
        transition: background 0.45s ease, color 0.35s ease;

        --theme-light: color-mix(in srgb, var(--theme-color) 85%, #FFFFFF);
        --theme-glow: color-mix(in srgb, var(--theme-color) 32%, transparent);
        --theme-border: color-mix(in srgb, var(--theme-color) 42%, transparent);
        --theme-border-subtle: color-mix(in srgb, var(--theme-color) 18%, transparent);
        --theme-badge-bg: color-mix(in srgb, var(--theme-color) 14%, transparent);
        --theme-card-bg: linear-gradient(
            165deg, 
            color-mix(in srgb, var(--theme-color) 14%, rgba(20, 26, 38, 0.94)) 0%, 
            color-mix(in srgb, var(--theme-color) 4%, rgba(8, 11, 17, 0.98)) 100%
        );
        --theme-card-inner: color-mix(in srgb, var(--theme-color) 8%, #090C12);
        --theme-metallic: linear-gradient(
            135deg, 
            #FFF8EB 0%, 
            color-mix(in srgb, var(--theme-color) 82%, #FFFFFF) 30%, 
            var(--theme-color) 60%, 
            color-mix(in srgb, var(--theme-color) 65%, #000000) 100%
        );
    }

    /* إضاءات الخلفية */
    .royal-light-sphere {
        position: absolute;
        border-radius: 50%;
        filter: blur(140px);
        pointer-events: none;
        z-index: 0;
        transition: background 0.5s ease;
    }
    .sphere-1 {
        width: 500px;
        height: 500px;
        top: -80px;
        right: -80px;
        background: radial-gradient(circle, var(--theme-glow) 0%, transparent 70%);
    }
    .sphere-2 {
        width: 480px;
        height: 480px;
        bottom: 80px;
        left: -100px;
        background: radial-gradient(circle, color-mix(in srgb, var(--theme-color) 20%, transparent) 0%, transparent 70%);
    }

    /* زر الرجوع */
    .btn-royal-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--theme-light);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.92rem;
        background: var(--theme-badge-bg);
        border: 1px solid var(--theme-border-subtle);
        padding: 8px 20px;
        border-radius: 50px;
        transition: all 0.25s ease;
    }
    .btn-royal-back:hover {
        background: var(--theme-metallic);
        color: #07090D;
        box-shadow: 0 4px 15px var(--theme-glow);
    }
    .back-arrow {
        font-size: 1.1rem;
        transition: transform 0.2s ease;
    }
    .btn-royal-back:hover .back-arrow {
        transform: translateX(4px);
    }

    /* البطاقة الملكية الفاخرة */
    .imperial-card {
        background: var(--theme-card-bg);
        border: 1px solid var(--theme-border);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75), 0 0 30px var(--theme-glow);
        backdrop-filter: blur(20px);
        transition: all 0.35s ease;
    }

    /* زخارف الزوايا */
    .gold-corner-filigree {
        position: absolute;
        width: 22px;
        height: 22px;
        pointer-events: none;
        opacity: 0.75;
    }
    .top-right-corner {
        top: 10px;
        right: 10px;
        border-top: 2px solid var(--theme-color);
        border-right: 2px solid var(--theme-color);
    }
    .top-left-corner {
        top: 10px;
        left: 10px;
        border-top: 2px solid var(--theme-color);
        border-left: 2px solid var(--theme-color);
    }

    /* الرمز الملكي العلوي */
    .monogram-outer-ring {
        width: 86px;
        height: 86px;
        border-radius: 50%;
        padding: 3px;
        background: var(--theme-metallic);
        box-shadow: 0 0 25px var(--theme-glow);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .monogram-inner-core {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 35%, #1C2333 0%, var(--theme-card-inner) 100%);
        color: var(--theme-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Amiri', 'Cinzel', serif;
        font-size: 2rem;
        font-weight: 700;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
    }
    .monogram-crown-pendant {
        position: absolute;
        top: -8px;
        right: 18px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--theme-metallic);
        color: #07090D;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.5);
    }
    .royal-svg-mini {
        width: 16px;
        height: 16px;
    }

    .royal-status-crest {
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--theme-light);
        background: var(--theme-badge-bg);
        padding: 4px 16px;
        border-radius: 50px;
        border: 1px solid var(--theme-border);
    }
    .royal-seal-id {
        font-family: 'Cinzel', monospace;
        font-weight: 800;
        font-size: 0.88rem;
        color: var(--theme-light);
        background: var(--theme-badge-bg);
        padding: 4px 10px;
        border-radius: 8px;
        border: 1px solid var(--theme-border-subtle);
    }

    .royal-form-title {
        font-family: 'Amiri', 'Cinzel', serif;
        font-weight: 700;
        font-size: 2rem;
        background: linear-gradient(135deg, #FFFFFF 0%, var(--theme-light) 35%, var(--theme-color) 70%, color-mix(in srgb, var(--theme-color) 60%, #000) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .royal-form-subtitle {
        color: #8E9BAE;
        font-size: 0.9rem;
    }
    .royal-divider {
        border-color: var(--theme-border-subtle);
        opacity: 1;
    }

    /* حقول الإدخال */
    .royal-input-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--theme-light);
    }
    .label-svg {
        width: 17px;
        height: 17px;
        color: var(--theme-color);
    }
    .royal-field-wrapper {
        position: relative;
    }
    .royal-form-control {
        width: 100%;
        background: var(--theme-card-inner);
        border: 1px solid var(--theme-border-subtle);
        border-radius: 12px;
        padding: 13px 18px;
        color: #FAF8F2;
        font-size: 0.95rem;
        font-family: inherit;
        transition: all 0.25s ease;
    }
    .royal-form-control:focus {
        outline: none;
        border-color: var(--theme-color);
        box-shadow: 0 0 20px var(--theme-glow);
        background: rgba(15, 20, 30, 0.95);
    }
    .royal-form-control::placeholder {
        color: #64748B;
    }
    .royal-field-error {
        display: block;
        color: #F87171;
        font-size: 0.82rem;
        font-weight: 600;
        margin-top: 5px;
    }
    .royal-validation-summary {
        background: rgba(220, 38, 38, 0.12);
        border: 1px solid rgba(220, 38, 38, 0.35);
        color: #FCA5A5;
    }

    /* الأزرار */
    .btn-imperial-action {
        background: var(--theme-metallic);
        color: #07090D !important;
        font-weight: 800;
        font-size: 0.96rem;
        border-radius: 12px;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        box-shadow: 0 8px 25px var(--theme-glow);
        transition: all 0.3s ease;
    }
    .btn-imperial-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 35px var(--theme-glow);
        color: #000 !important;
    }
    .btn-svg {
        width: 18px;
        height: 18px;
    }
    .btn-imperial-outline {
        background: transparent;
        color: var(--theme-light);
        border: 1px solid var(--theme-border);
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.25s ease;
    }
    .btn-imperial-outline:hover {
        background: var(--theme-badge-bg);
        border-color: var(--theme-color);
        color: #FFF;
    }
</style>

<!-- سكريبت المزامنة اللحظية مع صندوق الإعدادات -->
<script>
    function applyRoyalThemeColor(color) {
        if (!color) return;
        const normalized = color.trim().toLowerCase();
        const wrapper = document.getElementById('royalPageWrapper');
        if (wrapper) {
            wrapper.style.setProperty('--main--color', normalized);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const initialColor = localStorage.getItem("color_option") || 
                             getComputedStyle(document.documentElement).getPropertyValue('--main--color').trim() || 
                             '#084641';
        applyRoyalThemeColor(initialColor);

        // الاستماع لصندوق الإعدادات
        const colorItems = document.querySelectorAll(".setting-box .color-list li");
        colorItems.forEach(li => {
            li.addEventListener("click", function () {
                const pickedColor = this.dataset.color || this.getAttribute('data-color');
                if (pickedColor) applyRoyalThemeColor(pickedColor);
            });
        });

        // مراقب Style على :root
        const observer = new MutationObserver(() => {
            const dynamicColor = getComputedStyle(document.documentElement).getPropertyValue('--main--color').trim();
            if (dynamicColor) applyRoyalThemeColor(dynamicColor);
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['style'] });
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
